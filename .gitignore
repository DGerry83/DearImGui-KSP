# Build outputs
bin/
obj/
.vs/
DearImGuiKSPNative/build/

# Machine-specific KSP install pin
*.props.user

# Staged build artifacts (regenerated on every build; settings.cfg is source and stays tracked)
GameData/**/Plugins/*.dll
GameData/**/Plugins/*.pdb
GameData/**/PluginData/*.dll
GameData/**/*.version
GameData/**/Readme.txt
GameData/**/License.txt

# OS noise
Thumbs.db
Desktop.ini

# Issue tracker (local-only; evidence files must never touch history)
/ISSUES/

# Release artifacts (built by package_release.bat)
/dist/

# Local visual reference material (being folded into formal docs; not for history)
/VisualReferenceMaterial/
