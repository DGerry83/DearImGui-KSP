<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>DearImGuiKSP</RootNamespace>
		<AssemblyName>DearImGuiKSP</AssemblyName>
		<TargetFramework>net48</TargetFramework>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<PlatformTarget>x64</PlatformTarget>
		<Deterministic>true</Deterministic>
		<LangVersion>latest</LangVersion>
		<Version>1.2.0</Version>
		<Authors>DGerry83</Authors>
		<Company>DGerry83</Company>
		<Copyright>Copyright © DGerry83 2026</Copyright>
	</PropertyGroup>
	<!-- General -->
	<PropertyGroup>
		<RepoRoot Condition="'$(SolutionDir)' != ''">$(SolutionDir)</RepoRoot>
		<RepoRoot Condition="'$(SolutionDir)' == ''">$(MSBuildProjectDirectory)/../</RepoRoot>
	</PropertyGroup>
	<!-- KSPBT -->
	<PropertyGroup>
		<KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>
		<KSPBT_GenerateDependencyAttributes>false</KSPBT_GenerateDependencyAttributes>
	</PropertyGroup>
	<!-- AVC version file (generated to GameData mod folder on build).
	     KSP_Version_Min/Max pinned to 1.12.x (G3-04) — KSPBuildTools' item defaults
	     would otherwise advertise 1.8–1.12. -->
	<ItemGroup>
		<KSPVersionFile Include="$(MSBuildProjectDirectory)/DearImGuiKSP.version">
			<Destination>$(KSPBT_ModRoot)/DearImGuiKSP.version</Destination>
			<KSP_Version>1.12</KSP_Version>
			<KSP_Version_Min>1.12</KSP_Version_Min>
			<KSP_Version_Max>1.12</KSP_Version_Max>
		</KSPVersionFile>
	</ItemGroup>
	<!-- Packages -->
	<ItemGroup>
		<PackageReference Include="KSPBuildTools" Version="1.1.1" />
	</ItemGroup>
	<!-- Unit tests (tests/Application.Tests) -->
	<ItemGroup>
		<InternalsVisibleTo Include="Application.Tests" />
	</ItemGroup>
	<!-- Copy text files -->
	<Target Name="CopyTextFiles" AfterTargets="Build" BeforeTargets="CopyToGame">
		<Copy SourceFiles="$(RepoRoot)README.md" DestinationFiles="$(KSPBT_ModRoot)/Readme.txt" />
		<Copy SourceFiles="$(RepoRoot)LICENSE.txt" DestinationFiles="$(KSPBT_ModRoot)/License.txt" Condition="Exists('$(RepoRoot)LICENSE.txt')" />
	</Target>
	<!-- Copy mod folder to game -->
	<Target Name="CopyToGame" AfterTargets="Build" DependsOnTargets="KSPBT_GenerateVersionFile">
		<ItemGroup>
			<ModFiles Include="$(KSPBT_ModRoot)\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(ModFiles)" DestinationFiles="@(ModFiles->'$(KSPBT_GameRoot)/GameData/$(MSBuildProjectName)/%(RecursiveDir)%(Filename)%(Extension)')" />
	</Target>
</Project>
