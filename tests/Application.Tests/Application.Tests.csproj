<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Application.Tests</RootNamespace>
		<AssemblyName>Application.Tests</AssemblyName>
		<TargetFramework>net48</TargetFramework>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<!-- Machine-specific KSP pin (same mechanism as the library build); needed when
	     this project is built/tested outside the solution, where $(SolutionDir) is unset. -->
	<Import Project="..\..\DearImGui-KSP.props.user" Condition="Exists('..\..\DearImGui-KSP.props.user')" />
	<!-- Packages -->
	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
	</ItemGroup>
	<!-- System under test -->
	<ItemGroup>
		<ProjectReference Include="..\..\DearImGuiKSP\DearImGuiKSP.csproj" />
	</ItemGroup>
	<!-- UnityEngine.CoreModule (C8): the theming tests assert spec §6.1 palette
	     anchors on Color32 values, which requires the Unity type at compile time
	     and run time (Color32/Vector2 are pure structs — safe outside Unity). The
	     library resolves it through KSPBuildTools' FrameworkPathOverride; the test
	     project has no KSPBuildTools, so copy the assembly from the pinned game
	     instance instead. -->
	<ItemGroup Condition="Exists('$(KSPBT_GameRoot)\KSP_x64_Data\Managed\UnityEngine.CoreModule.dll')">
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(KSPBT_GameRoot)\KSP_x64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
			<Private>true</Private>
		</Reference>
	</ItemGroup>
</Project>
