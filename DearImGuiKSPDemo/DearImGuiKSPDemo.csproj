<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>DearImGuiKSPDemo</RootNamespace>
		<AssemblyName>DearImGuiKSPDemo</AssemblyName>
		<TargetFramework>net48</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<Deterministic>true</Deterministic>
		<LangVersion>latest</LangVersion>
		<Version>1.0.1</Version>
		<Authors>DGerry83</Authors>
		<Company>DGerry83</Company>
		<Copyright>Copyright © DGerry83 2026</Copyright>
	</PropertyGroup>
	<!-- General -->
	<PropertyGroup>
		<RepoRoot Condition="'$(SolutionDir)' != ''">$(SolutionDir)</RepoRoot>
		<RepoRoot Condition="'$(SolutionDir)' == ''">$(MSBuildProjectDirectory)/../</RepoRoot>
	</PropertyGroup>
	<!-- KSPBT -->
	<PropertyGroup>
		<KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>
		<KSPBT_GenerateDependencyAttributes>false</KSPBT_GenerateDependencyAttributes>
	</PropertyGroup>
	<!-- AVC version file (generated to GameData mod folder on build).
	     KSP_Version_Min/Max pinned to 1.12.x (G3-38) — KSPBuildTools' item defaults
	     would otherwise advertise 1.8–1.12. -->
	<ItemGroup>
		<KSPVersionFile Include="$(MSBuildProjectDirectory)/DearImGuiKSPDemo.version">
			<Destination>$(KSPBT_ModRoot)/DearImGuiKSPDemo.version</Destination>
			<KSP_Version>1.12</KSP_Version>
			<KSP_Version_Min>1.12</KSP_Version_Min>
			<KSP_Version_Max>1.12</KSP_Version_Max>
		</KSPVersionFile>
	</ItemGroup>
	<!-- Packages -->
	<ItemGroup>
		<PackageReference Include="KSPBuildTools" Version="1.1.1" />
	</ItemGroup>
	<!-- Compile against the library, but do not copy its DLL into the demo's GameData —
	     the game loads DearImGuiKSP.dll from GameData/DearImGuiKSP at runtime. -->
	<ItemGroup>
		<ProjectReference Include="../DearImGuiKSP/DearImGuiKSP.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>
	<!-- Copy text files (G3-37: demo zip must ship Readme.txt + License.txt too) -->
	<Target Name="CopyTextFiles" AfterTargets="Build" BeforeTargets="CopyToGame">
		<Copy SourceFiles="$(MSBuildProjectDirectory)/Readme.txt" DestinationFiles="$(KSPBT_ModRoot)/Readme.txt" />
		<Copy SourceFiles="$(RepoRoot)LICENSE.txt" DestinationFiles="$(KSPBT_ModRoot)/License.txt" Condition="Exists('$(RepoRoot)LICENSE.txt')" />
	</Target>
	<!-- Copy mod folder to game -->
	<Target Name="CopyToGame" AfterTargets="Build" DependsOnTargets="KSPBT_GenerateVersionFile">
		<ItemGroup>
			<ModFiles Include="$(KSPBT_ModRoot)\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(ModFiles)" DestinationFiles="@(ModFiles->'$(KSPBT_GameRoot)/GameData/$(MSBuildProjectName)/%(RecursiveDir)%(Filename)%(Extension)')" />
	</Target>
</Project>
