<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>DearImGuiKSPDemo</RootNamespace>
		<AssemblyName>DearImGuiKSPDemo</AssemblyName>
		<TargetFramework>net48</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<Deterministic>true</Deterministic>
		<LangVersion>latest</LangVersion>
		<Version>1.0.0</Version>
		<Copyright>Copyright © DGerry 2026</Copyright>
	</PropertyGroup>
	<!-- General -->
	<PropertyGroup>
		<RepoRoot Condition="'$(SolutionDir)' != ''">$(SolutionDir)</RepoRoot>
		<RepoRoot Condition="'$(SolutionDir)' == ''">$(MSBuildProjectDirectory)/../</RepoRoot>
	</PropertyGroup>
	<!-- KSPBT -->
	<PropertyGroup>
		<KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>
		<KSPBT_GenerateDependencyAttributes>false</KSPBT_GenerateDependencyAttributes>
	</PropertyGroup>
	<!-- AVC version file (generated to GameData mod folder on build) -->
	<ItemGroup>
		<KSPVersionFile Include="$(MSBuildProjectDirectory)/DearImGuiKSPDemo.version">
			<Destination>$(KSPBT_ModRoot)/DearImGuiKSPDemo.version</Destination>
		</KSPVersionFile>
	</ItemGroup>
	<!-- Packages -->
	<ItemGroup>
		<PackageReference Include="KSPBuildTools" Version="1.1.1" />
	</ItemGroup>
	<!-- Compile against the library, but do not copy its DLL into the demo's GameData —
	     the game loads DearImGuiKSP.dll from GameData/DearImGuiKSP at runtime. -->
	<ItemGroup>
		<ProjectReference Include="../DearImGuiKSP/DearImGuiKSP.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>
	<!-- Copy mod folder to game -->
	<Target Name="CopyToGame" AfterTargets="Build" DependsOnTargets="KSPBT_GenerateVersionFile">
		<ItemGroup>
			<ModFiles Include="$(KSPBT_ModRoot)\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(ModFiles)" DestinationFiles="@(ModFiles->'$(KSPBT_GameRoot)/GameData/$(MSBuildProjectName)/%(RecursiveDir)%(Filename)%(Extension)')" />
	</Target>
</Project>
