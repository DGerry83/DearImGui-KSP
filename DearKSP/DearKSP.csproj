<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>DearKSP</RootNamespace>
		<AssemblyName>DearKSP</AssemblyName>
		<TargetFramework>net48</TargetFramework>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<PlatformTarget>x64</PlatformTarget>
		<Deterministic>true</Deterministic>
		<LangVersion>latest</LangVersion>
		<Version>0.1.0.0</Version>
		<Copyright>Copyright © DGerry 2026</Copyright>
	</PropertyGroup>
	<!-- General -->
	<PropertyGroup>
		<RepoRoot Condition="'$(SolutionDir)' != ''">$(SolutionDir)</RepoRoot>
		<RepoRoot Condition="'$(SolutionDir)' == ''">$(MSBuildProjectDirectory)/../</RepoRoot>
	</PropertyGroup>
	<!-- KSPBT -->
	<PropertyGroup>
		<KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>
		<KSPBT_GenerateDependencyAttributes>false</KSPBT_GenerateDependencyAttributes>
	</PropertyGroup>
	<!-- AVC version file (generated to GameData mod folder on build) -->
	<ItemGroup>
		<KSPVersionFile Include="$(MSBuildProjectDirectory)/DearKSP.version">
			<Destination>$(KSPBT_ModRoot)/DearKSP.version</Destination>
		</KSPVersionFile>
	</ItemGroup>
	<!-- Packages -->
	<ItemGroup>
		<PackageReference Include="KSPBuildTools" Version="1.1.1" />
	</ItemGroup>
	<!-- Copy text files -->
	<Target Name="CopyTextFiles" AfterTargets="Build" BeforeTargets="CopyToGame">
		<Copy SourceFiles="$(RepoRoot)README.md" DestinationFiles="$(KSPBT_ModRoot)/Readme.txt" />
		<Copy SourceFiles="$(RepoRoot)LICENSE" DestinationFiles="$(KSPBT_ModRoot)/License.txt" Condition="Exists('$(RepoRoot)LICENSE')" />
	</Target>
	<!-- Copy mod folder to game -->
	<Target Name="CopyToGame" AfterTargets="Build" DependsOnTargets="KSPBT_GenerateVersionFile">
		<ItemGroup>
			<ModFiles Include="$(KSPBT_ModRoot)\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(ModFiles)" DestinationFiles="@(ModFiles->'$(KSPBT_GameRoot)/GameData/$(MSBuildProjectName)/%(RecursiveDir)%(Filename)%(Extension)')" />
	</Target>
</Project>
